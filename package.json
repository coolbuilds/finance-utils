{
  "name": "@coolbuilds/finance-utils",
  "version": "1.0.5",
  "description": "A modular TypeScript toolkit for financial logic.",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write .",
    "contributors": "node scripts/updateContributors.mjs",
    "build": "npm run lint && prettier --check . && tsup src/index.ts --format esm,cjs --dts",
    "prepublishOnly": "npm run test:run && npm run build",
    "test": "vitest",
    "test:run": "vitest run",
    "coverage": "vitest run --coverage",
    "coverage:badge": "coverage-badges --output badges",
    "coverage:badges": "coverage-badges --source coverage/coverage-summary.json --output badges.svg --format svg"
  },
  "keywords": [
    "finance",
    "fintech",
    "installment",
    "masking",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coolbuilds/finance-utils.git"
  },
  "bugs": {
    "url": "https://github.com/coolbuilds/finance-utils/issues"
  },
  "homepage": "https://github.com/coolbuilds/finance-utils#readme",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "@vitest/coverage-v8": "^4.1.5",
    "coverage-badges-cli": "^2.2.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "prettier": "^3.8.3",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.1",
    "vitest": "^4.1.5"
  }
}
